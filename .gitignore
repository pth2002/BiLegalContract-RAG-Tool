# ======================
# Python / FastAPI
# ====================== 
__pycache__/
*.py[cod]
*$py.class

# virtualenv
venv/
.venv/
backend/venv/
backend/.venv/

# pytest / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/

# env / secrets — never commit real credentials
/.env
backend/.env
.env.local
.env.production
backend/.env.local
backend/.env.production
# .env.example is intentionally tracked (template for users)

