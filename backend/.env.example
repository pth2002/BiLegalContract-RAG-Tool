# Contract Review Tool — Environment Configuration
# Copy this file to .env and fill in real values

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/contract_rag
VECTOR_MEMORY_DSN=postgresql://user:password@localhost:5432/contract_agent

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here

# ── Retrieval tuning ──────────────────────────────────────────────────────────
RETRIEVER_TOP_K=8
HYBRID_RRF_K=60
COARSE_RECALL_MULT=6
COARSE_RECALL_MAX_PER_QUERY=24
RETRIEVAL_FILTER_MIN_CHARS=80
PGVECTOR_PROBES=100

# ── Reranker ──────────────────────────────────────────────────────────────────
RERANK_MODEL=BAAI/bge-reranker-large
RERANK_BATCH_SIZE=8
RERANK_POOL_MULT=4

# ── Hugging Face / offline model loading ──────────────────────────────────────
# Set HF_HUB_OFFLINE=1 after downloading models to avoid network calls at runtime
HF_HOME=/path/to/hf_cache
HUGGINGFACE_HUB_CACHE=/path/to/hf_cache/hub
TRANSFORMERS_CACHE=/path/to/hf_cache/transformers
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ── Ollama (optional — only needed if using local LLM via Ollama) ─────────────
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# ── LLM parameters (optional overrides) ──────────────────────────────────────
# LLM_TEMPERATURE=0.1
# LLM_NUM_CTX=4096
# LLM_NUM_PREDICT=2048
# LLM_REASONING=false

# ── Analysis limits (optional overrides) ─────────────────────────────────────
# MAX_PDF_SIZE=2097152
# MAX_DOCX_SIZE=5242880
# MAX_PDF_PAGES=20

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL=DEBUG
